# Copy to .env and fill in. .env is git-ignored. NEVER commit real values.
# Golden Rule 6: private keys / WIF / seed phrases are provided via env or a wallet ONLY,
# never hardcoded, never stored in the DB (the DB holds public keys / references only).

# Target network for a given run: testnet | mainnet
PM_NETWORK=testnet

# Path to the local SQLite spike database
PM_DB_PATH=./data/spike.db

# Funding key for broadcasting spike transactions (WIF). Loaded at runtime only.
# Leave blank on shared machines; inject at invocation time.
PM_FUNDING_WIF=

# Oracle signing key (WIF) — used only by the mock-Kalshi resolution signer.
PM_ORACLE_WIF=

# WhatsOnChain API key (optional, for higher rate limits)
WOC_API_KEY=
