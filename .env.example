# Copy to .env and fill in. .env is git-ignored. NEVER commit real values.
# Golden Rule 6: private keys / WIF / seed phrases are provided via env or a wallet ONLY,
# never hardcoded, never stored in the DB (the DB holds public keys / references only).

# Target network. Mainnet only per ADR-010 (no testnet).
PM_NETWORK=mainnet

# Path to the local SQLite spike database
# Relative paths are resolved against the REPO ROOT, not the working directory — the daemon runs
# with its CWD in apps/daemon, so `data/x.db` would otherwise land in apps/daemon/data/.
# Keep mainnet in its own file: a mainnet daemon on the wrong database is not an error, it is a
# working daemon showing the wrong markets.
PM_DB_PATH=./data/spike.db

# Funding key for broadcasting spike transactions (WIF). Loaded at runtime only.
# Leave blank on shared machines; inject at invocation time.
PM_FUNDING_WIF=

# Sequencer key (WIF) for signing off-chain execution receipts (CONC-001/002). Separate from the funding
# wallet; holds no funds. Loaded at runtime only. If blank, the daemon falls back to the funding key.
# Generate with: pnpm --filter @pm/spike keygen:sequencer  (writes here, prints only the public key/address).
PM_SEQUENCER_WIF=

# Oracle signing key (WIF) — used only by the mock-Kalshi resolution signer.
PM_ORACLE_WIF=

# WhatsOnChain API key (optional, for higher rate limits)
WOC_API_KEY=

# Operator token for the web console. Operator routes (deploy/settle/resolve/payout/authorize/reject) SPEND
# REAL MONEY, so they require this in the `x-pm-operator-token` header. Leave blank to keep them open (dev only).
# NOTE: a shared secret over loopback HTTP — adequate locally, never a reason to expose the daemon to a network.
PM_OPERATOR_TOKEN=

# Fee rate in satoshis per 1000 bytes. Default 100 = the published miner minimum (TAAL / GorillaPool ARC
# /v1/policy: miningFee { bytes: 1000, satoshis: 100 }, verified 2026-08-07). This is the biggest lever on
# running cost: the pool covenant republishes the whole compiled contract on every spend, so fee ≈ size × rate.
# Raise it only if transactions sit unconfirmed — it is miner policy, not consensus.
PM_FEE_PER_KB=100

# FUND-001 — the key trader STAKES are paid to (WIF). BRC-29 destinations are derived from it, and it is the
# only thing that can later spend them. Keep it SEPARATE from PM_FUNDING_WIF so stake money and fee money are
# not commingled and a market's solvency is measurable. Falls back to the funding key if unset.
PM_PAYMENT_WIF=
